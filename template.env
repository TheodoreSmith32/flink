# Dinky + Flink versions (must match an existing tag on Docker Hub:
# https://hub.docker.com/r/dinkydocker/dinky-standalone-server/tags)
DINKY_VERSION=1.2.5
FLINK_VERSION=1.17
FLINK_FULL_VERSION=1.17.2

TZ=Asia/Jakarta

# Dinky metadata DB: h2, mysql or postgresql. mysql is used here so state
# survives container recreation (h2 is file-based and fine for a quick trial
# only, per Dinky's own docs).
DB_ACTIVE=mysql
MYSQL_ADDR=mysql:3306
MYSQL_DATABASE=dinky
MYSQL_USERNAME=dinky
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Kafka broker kamu sendiri (multi-broker, pisahkan dengan koma tanpa spasi),
# misal: broker1.internal:9092,broker2.internal:9092,broker3.internal:9092
# Isi sendiri -- sengaja tidak di-hardcode di script Python biar tidak
# ketinggalan di kode/commit.
KAFKA_BOOTSTRAP_SERVERS=broker1.internal:9092,broker2.internal:9092,broker3.internal:9092
KAFKA_TOPIC=your_topic_name

# URL Confluent Schema Registry -- cuma dipakai kalau topic-mu pakai Avro
# (lihat jobs/avro_schema_lookup.py dan jobs/hello_flink_kafka_avro.py).
# Kalau registry-mu butuh basic-auth, tambahkan sendiri
# SCHEMA_REGISTRY_USER / SCHEMA_REGISTRY_PASSWORD dan pakai di DDL avro-confluent.
SCHEMA_REGISTRY_URL=http://localhost:8081

# API key buat tab "LLM Chat" (Gemini). Isi sendiri -- sama alasannya
# dengan KAFKA_BOOTSTRAP_SERVERS, biar gak ketinggalan di kode/commit.
# Bikin key di https://aistudio.google.com/apikey kalau belum punya.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Postgres LOCAL kamu -- dipakai jobs/flink_sink_postgre/topic_to_postgre.py
# buat nyink hasil query Kafka. Isi sendiri (cek `pg_lsclusters` kalau lupa
# port instance lokalmu, defaultnya 5432 tapi bisa beda).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=your_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_TABLE=kafka_sink

# Fraud detection demo (usecases/fraud_detection/) -- Kafka & Postgres LOKAL
# lewat docker-compose.yml, SENGAJA terpisah dari KAFKA_BOOTSTRAP_SERVERS/
# KAFKA_TOPIC di atas (itu broker dev Bank Sinarmas beneran, jangan dipakai
# buat kirim data transaksi palsu). Nilai di bawah ini defaultnya sudah
# cocok sama docker-compose.yml -- gak perlu diisi kalau kamu jalankan
# `docker compose up -d` tanpa ubah apa-apa. POSTGRES_HOST/PORT/DB/USER/
# PASSWORD di atas dipakai lagi kalau kamu isi manual (fraud_job.py &
# llm_explainer_worker.py fallback ke localhost:5433/fraud_demo/postgres/
# postgres kalau env var-nya kosong).
KAFKA_FRAUD_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_FRAUD_TOPIC=fraud_transactions
